{
  "api_url": {
    "description": "API 基础地址",
    "type": "string",
    "default": "https://api.apimart.ai/v1"
  },
  "api_key": {
    "description": "API Key",
    "type": "string",
    "hint": "从 apimart.ai/keys 获取",
    "obvious_hint": true
  },
  "whitelist": {
    "description": "用户白名单（留空则所有人可用）",
    "type": "list",
    "default": [],
    "hint": "填写 QQ 号或平台用户 ID"
  },
  "daily_limit": {
    "description": "每日每人使用次数上限",
    "type": "int",
    "default": 10,
    "hint": "0 表示不限制"
  },
  "default_size": {
    "description": "默认宽高比",
    "type": "string",
    "default": "1:1",
    "options": ["auto", "1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5", "16:9", "9:16", "2:1", "1:2", "21:9", "9:21"]
  },
  "default_resolution": {
    "description": "默认分辨率档位",
    "type": "string",
    "default": "2k",
    "options": ["1k", "2k", "4k"],
    "hint": "4K 仅支持 16:9, 9:16, 2:1, 1:2, 21:9, 9:21"
  },
  "default_quality": {
    "description": "默认图片质量",
    "type": "string",
    "default": "auto",
    "options": ["auto", "low", "medium", "high"]
  },
  "max_retries": {
    "description": "最大轮询次数",
    "type": "int",
    "default": 30,
    "hint": "high + 2K/4K 可能需要 130 秒"
  },
  "poll_interval": {
    "description": "轮询间隔（秒）",
    "type": "int",
    "default": 5,
    "hint": "建议 3-5 秒"
  }
}
